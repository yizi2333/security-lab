# venv: thousands of files, rebuildable with pip install
.venv/

# Python bytecode cache: ignore at any depth
**/__pycache__/
*.pyc
*.pyo

# Editor / OS junk
.vscode/settings.json
Thumbs.db
desktop.ini

# generated test lab (rebuildable via tools/setup_lab.py)
lab/

# generated / scanned test data and reports
access*.log
result*.txt
report*.txt
screen*.txt
